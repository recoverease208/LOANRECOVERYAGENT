# Production frontend variables for Vercel.
# Do not store secret backend keys here. Use Supabase and n8n secret stores instead.

VITE_APP_NAME=Settlie AI
VITE_APP_URL=https://your-vercel-domain.vercel.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key
VITE_SENTRY_DSN=https://example.ingest.sentry.io/project
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxx
VITE_N8N_WEBHOOK_BASE_URL=https://automation.yourdomain.com/webhook
VITE_CLOUDINARY_CLOUD_NAME=your-cloud
VITE_ENABLE_DEMO_DATA=false
