# n8n environment variables for webhook-driven automations.

N8N_HOST=automation.yourdomain.com
N8N_WEBHOOK_URL=https://automation.yourdomain.com
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_ACCESS_TOKEN=
RESEND_API_KEY=
CLOUDINARY_URL=
